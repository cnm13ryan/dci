# Working evidence and its durable mirror: registered artifacts are
# content-hashed and signed, and runs must never dirty the Git worktree
# (prereg v3 §28 / item 10), so they live outside version control.
# Anchored with a leading slash to the two roots beside this file. Unanchored,
# `evidence/` also matched the v2 source package `src/dci1/evidence/`, and its
# six modules were never committed.
/evidence/
/durable_root/

# Environments (rebuilt from the committed uv locks). No trailing slash: a
# secondary `git worktree` links its environment rather than copying it, and
# a slash-terminated pattern matches directories only, so `.venv/` left the
# symlink untracked. An untracked path is not cosmetic here --- every v5, v6,
# v7 and v8 registration has a `clean_worktree` precondition that reads
# `git status --porcelain`, so a linked environment made the worktree fail
# qualification.
.venv
environments/backend/.venv

# The vendored ROCm wheels are pinned by environments/backend/vendor/
# MANIFEST.sha256; the binaries themselves stay out of git.
environments/backend/vendor/*.whl

# Python build noise.
__pycache__/
*.pyc
src/*.egg-info/

# Gate 1 annotation workspace (reviewer GUI working files; the exported
# annotations file enters evidence only through `gate1 --annotations`).
annotations/
