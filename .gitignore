# Byte-compiled artefacts and tool caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtual environments. uv already writes .venv/.gitignore containing "*", and
# pytest writes .pytest_cache/.gitignore; these entries make the intent explicit
# rather than dependent on those tools continuing to do so.
.venv/
venv/

# Local run output. Every shipped profile defaults data_root to "artifacts", and
# the runner writes stop.json at the run root. Scientific artefacts are
# reproduced from the frozen manifest and hashes, never version controlled; the
# only committed run output is the deliberate regression baseline under
# tests/regression/fixture_dev_fast/.
artifacts/
stop.json

# Editor and OS noise
.DS_Store
*.sw[op]
*.un~

# Exploratory study (exploratory/) run output. Each run gets its own directory
# under exploratory/runs/ holding raw generations, figures and audit exports.
# Raw generations are what make the headline numbers independently recomputable,
# so they are kept on disk and reported by path — but they are run artefacts,
# not source, and are regenerated by the documented command.
exploratory/runs/

# Dedicated vLLM ROCm backend environment for the TP=2 cross-model retry.
# Generation runs in this env; scoring runs in exploratory/.venv, as the
# canonical vllm_backend/ scripts already do. Never version-controlled.
.venv-vllm/
